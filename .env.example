# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Zoho Mail (Reply Portal contact form) ---
# ZOHO_EMAIL: the mailbox that sends and receives enquiries, e.g. sales@themeatdirect.com.au
ZOHO_EMAIL="sales@themeatdirect.com.au"
# ZOHO_APP_PASSWORD: an app-specific password generated in Zoho Mail
# (Zoho Mail > Settings > Security > App Passwords) — never the account login password.
ZOHO_APP_PASSWORD="MY_ZOHO_APP_PASSWORD"
# ZOHO_SMTP_HOST: Zoho's Australian SMTP relay. Defaults to smtppro.zoho.com.au if unset.
ZOHO_SMTP_HOST="smtppro.zoho.com.au"
# CONTACT_TO_EMAIL: where website enquiries are delivered. Defaults to ZOHO_EMAIL if unset.
CONTACT_TO_EMAIL="sales@themeatdirect.com.au"
